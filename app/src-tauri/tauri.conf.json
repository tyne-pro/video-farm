{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TyneFarm",
  "version": "1.5.0",
  "identifier": "pro.tyne.farm",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ферма роликів · tyne.pro",
        "width": 520,
        "height": 780,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:4747 https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "Video",
    "shortDescription": "Ферма роликів tyne.pro",
    "longDescription": "Edits TikTok, Reels and Shorts clips on your computer for the tyne.pro cabinet.",
    "copyright": "© tyne.pro",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/node", "binaries/ffmpeg", "binaries/ffprobe"],
    "resources": { "resources/generator/": "generator/", "resources/NOTICE.txt": "NOTICE.txt" },
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["tynefarm"] } }
  }
}
